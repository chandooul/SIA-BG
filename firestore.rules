rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: officers
    // Fields:
    //   - name: string (required)
    //   - registration: string (required)
    //   - unit: string (required)
    //   - rank: string (optional)
    //
    // Collection: units
    // Fields:
    //   - name: string (required)
    //   - acronym: string (optional)
    //
    // Collection: searchTerms
    // Fields:
    //   - term: string (required)
    //   - category: string (optional)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isAuthenticated() && 
             request.auth.token.get('email', '') != '' &&
             request.auth.token.email.lower() == "chandooul@gmail.com" && 
             request.auth.token.email_verified == true;
    }

    function isAuthorizedAdmin() {
      return isAuthenticated() && 
             request.auth.token.get('email', '') != '' &&
             exists(/databases/$(database)/documents/authorized_admins/$(request.auth.token.email.lower()));
    }

    function isDatabaseAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAdmin() {
      return isMasterAdmin() || isAuthorizedAdmin() || isDatabaseAdmin();
    }

    function isOfficerOwner(officerId) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.officerId == officerId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidOfficer(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.registration is string && data.registration.size() > 0 && data.registration.size() < 50 &&
             data.unit is string && data.unit.size() > 0 && data.unit.size() < 200 &&
             (!('password' in data) || (data.password is string && data.password.size() < 100)) &&
             (!('keywords' in data) || (data.keywords is list && data.keywords.size() < 50)) &&
             (!('email' in data) || (data.email is string && data.email.size() < 100)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() < 50));
    }

    function isValidUnit(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             (!('acronym' in data) || (data.acronym is string && data.acronym.size() < 50));
    }

    function isValidSearchTerm(data) {
      return data.term is string && data.term.size() > 0 && data.term.size() < 200 &&
             (!('category' in data) || (data.category is string && data.category.size() < 100));
    }

    function isValidBGAnalysis(data) {
      return data.fileName is string && data.fileName.size() > 0 &&
             data.uploadedAt is string && data.uploadedAt.size() > 0 &&
             data.results is list &&
             (!('pdfUrl' in data) || data.pdfUrl is string) &&
             (!('uploadedBy' in data) || data.uploadedBy is string) &&
             (!('bgNumber' in data) || data.bgNumber is string) &&
             (!('bgDate' in data) || data.bgDate is string) &&
             (!('docType' in data) || data.docType is string) &&
             (!('fullText' in data) || data.fullText is list);
    }

    // Rules for BG Analysis - ensure public read access
    match /bg_analysis/latest {
      allow read: if true;
      allow write: if isAdmin() && (request.resource.data == null || isValidBGAnalysis(request.resource.data));
    }

    match /bg_analysis/{bgId} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource.data == null || isValidBGAnalysis(request.resource.data));
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    match /officers/{officerId} {
      allow read: if true;
      allow update: if isAdmin() || (isOfficerOwner(officerId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['password', 'isFirstAccess', 'keywords', 'email', 'phone']));
      allow create, delete: if isAdmin();
    }

    match /units/{unitId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidUnit(request.resource.data);
      allow delete: if isAdmin();
    }

    match /searchTerms/{termId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidSearchTerm(request.resource.data);
      allow delete: if isAdmin();
    }

    match /authorized_admins/{adminEmail} {
      allow read: if isAuthenticated() && (request.auth.token.email.lower() == adminEmail || isAdmin());
      allow write: if isAdmin() && adminEmail == adminEmail.lower();
    }
  }
}
