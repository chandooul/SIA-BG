rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: officers
    // Fields:
    //   - name: string (required)
    //   - registration: string (required)
    //   - unit: string (required)
    //   - rank: string (optional)
    //
    // Collection: units
    // Fields:
    //   - name: string (required)
    //   - acronym: string (optional)
    //
    // Collection: searchTerms
    // Fields:
    //   - term: string (required)
    //   - category: string (optional)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == "chandooul@gmail.com" && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidOfficer(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.registration is string && data.registration.size() > 0 && data.registration.size() < 50 &&
             data.unit is string && data.unit.size() > 0 && data.unit.size() < 200 &&
             (!('password' in data) || (data.password is string && data.password.size() < 100)) &&
             (!('keywords' in data) || (data.keywords is list && data.keywords.size() < 50));
    }

    function isValidUnit(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             (!('acronym' in data) || (data.acronym is string && data.acronym.size() < 50));
    }

    function isValidSearchTerm(data) {
      return data.term is string && data.term.size() > 0 && data.term.size() < 200 &&
             (!('category' in data) || (data.category is string && data.category.size() < 100));
    }

    // Rules
    match /users/{userId} {
      // Allow users to manage their own profile/role cache
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    match /officers/{officerId} {
      allow read: if true;
      // Allow users to update their own password, first access flag, and keywords
      allow update: if isAdmin() || 
        (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['password', 'isFirstAccess', 'keywords']));
      allow create, delete: if isAdmin();
    }

    match /units/{unitId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidUnit(request.resource.data);
      allow delete: if isAdmin();
    }

    match /searchTerms/{termId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidSearchTerm(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
