rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /bg_files/{allPaths=**} {
      allow read: if true;
      // Allow write access to any authenticated user for now to fix the upload issue
      // We will refine this once we confirm the connection is working
      allow write: if request.auth != null;
    }
  }
}
